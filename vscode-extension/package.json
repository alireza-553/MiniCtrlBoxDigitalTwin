{
  "name": "mcb-digital-twin",
  "displayName": "MiniCtrlBox Digital Twin",
  "description": "Startet, testet und öffnet Python-Digitalzwillinge für MiniCtrlBox-Projekte.",
  "version": "0.3.11",
  "publisher": "itt56-local",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Testing"
  ],
  "activationEvents": [
    "onCommand:mcbDigitalTwin.start",
    "onCommand:mcbDigitalTwin.menu",
    "onCommand:mcbDigitalTwin.stop",
    "onCommand:mcbDigitalTwin.restart",
    "onCommand:mcbDigitalTwin.open",
    "onCommand:mcbDigitalTwin.test",
    "onCommand:mcbDigitalTwin.upload",
    "onCommand:mcbDigitalTwin.debug",
    "onView:mcbDigitalTwin.control",
    "onCommand:mcbDigitalTwin.hardwareUpload",
    "onCommand:mcbDigitalTwin.hardwareDebug",
    "onCommand:mcbDigitalTwin.hardwareDrivers",
    "onCommand:mcbDigitalTwin.searchVariables"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mcbDigitalTwin",
          "title": "MiniCtrlBox Digital Twin",
          "icon": "media/mcb.svg"
        }
      ]
    },
    "views": {
      "mcbDigitalTwin": [
        {
          "id": "mcbDigitalTwin.control",
          "name": "Steuerung"
        }
      ]
    },
    "commands": [
      {
        "command": "mcbDigitalTwin.menu",
        "title": "Digital-Twin-Steuerung öffnen",
        "category": "MiniCtrlBox"
      },
      {
        "command": "mcbDigitalTwin.debug",
        "title": "C++-Projekt im Digital Twin debuggen",
        "category": "MiniCtrlBox",
        "icon": "$(debug-alt)"
      },
      {
        "command": "mcbDigitalTwin.upload",
        "title": "Geöffnetes Projekt in den Digital Twin hochladen",
        "category": "MiniCtrlBox",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "mcbDigitalTwin.start",
        "title": "MiniCtrlBox: Digital Twin starten",
        "category": "MiniCtrlBox"
      },
      {
        "command": "mcbDigitalTwin.stop",
        "title": "MiniCtrlBox: Digital Twin stoppen",
        "category": "MiniCtrlBox"
      },
      {
        "command": "mcbDigitalTwin.restart",
        "title": "Digital Twin neu starten",
        "category": "MiniCtrlBox",
        "icon": "$(debug-restart)"
      },
      {
        "command": "mcbDigitalTwin.open",
        "title": "MiniCtrlBox: Digital Twin öffnen",
        "category": "MiniCtrlBox"
      },
      {
        "command": "mcbDigitalTwin.test",
        "title": "MiniCtrlBox: Digital Twin testen",
        "category": "MiniCtrlBox"
      },
      {
        "command": "mcbDigitalTwin.hardwareUpload",
        "title": "Echte Hardware programmieren",
        "category": "MiniCtrlBox",
        "icon": "$(circuit-board)"
      },
      {
        "command": "mcbDigitalTwin.hardwareDebug",
        "title": "Echte Hardware debuggen (USB)",
        "category": "MiniCtrlBox",
        "icon": "$(debug-alt-small)"
      },
      {
        "command": "mcbDigitalTwin.hardwareDrivers",
        "title": "USB-JTAG-Treiber einrichten",
        "category": "MiniCtrlBox",
        "icon": "$(tools)"
      },
      {
        "command": "mcbDigitalTwin.searchVariables",
        "title": "Variable suchen und überwachen",
        "category": "MiniCtrlBox",
        "icon": "$(search)",
        "enablement": "debugState == stopped"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mcbDigitalTwin.debug",
          "when": "view == mcbDigitalTwin.control",
          "group": "navigation@2"
        },
        {
          "command": "mcbDigitalTwin.upload",
          "when": "view == mcbDigitalTwin.control",
          "group": "navigation@1"
        },
        {
          "command": "mcbDigitalTwin.searchVariables",
          "when": "(view == workbench.debug.watchExpressionsView || view == workbench.debug.variablesView) && debugState == stopped",
          "group": "navigation@0"
        }
      ]
    },
    "configuration": {
      "title": "MiniCtrlBox Digital Twin",
      "properties": {
        "mcbDigitalTwin.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python-Interpreter für den Digital Twin."
        },
        "mcbDigitalTwin.openInsideVSCode": {
          "type": "boolean",
          "default": true,
          "description": "Öffnet die Oberfläche im integrierten Simple Browser."
        },
        "mcbDigitalTwin.platformioPath": {
          "type": "string",
          "default": "",
          "description": "PlatformIO-Programmdatei. Leer: Core der PlatformIO-IDE oder platformio im PATH."
        },
        "mcbDigitalTwin.skipArduinoLoopTask": {
          "type": "boolean",
          "default": true,
          "description": "Nach F10/F11 beim Rücksprung in Arduinos loopTask bis zum nächsten loop()-Eintritt weiterlaufen. Haltepunkte und manuelles Anhalten bleiben erhalten. Für Einzelschritte in der Arduino-Hülle abschalten und die Debugsitzung neu starten."
        },
        "mcbDigitalTwin.autoInstallJtagDriver": {
          "type": "boolean",
          "default": true,
          "description": "Fehlenden Windows-USB-JTAG-Treiber vor Hardware-Debugging automatisch einrichten. Windows fragt bei Bedarf nach Administratorrechten."
        }
      }
    }
  },
  "scripts": {
    "check": "node --check extension.js",
    "test": "node --test test/*.test.js"
  }
}
